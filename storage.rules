rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /notes/{userId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.contentType in ['application/pdf', 'application/zip', 'application/x-zip-compressed', 'application/x-zip', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'application/x-rar-compressed', 'application/vnd.rar']
        && request.resource.size < 25 * 1024 * 1024;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
