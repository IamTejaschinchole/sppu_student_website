rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function noteOwner(noteId) {
      return signedIn()
        && get(/databases/$(database)/documents/notes/$(noteId)).data.uploadedBy == request.auth.uid;
    }

    function validNoteCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'title',
          'subject',
          'semester',
          'description',
          'tags',
          'price',
          'priceType',
          'priceAmount',
          'storagePath',
          'fileName',
          'uploadedBy',
          'uploaderName',
          'uploaderAvatar',
          'createdAt',
          'downloads',
          'rating',
          'ratingCount'
        ])
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.subject is string
        && request.resource.data.semester in [3, 4]
        && request.resource.data.tags is list
        && request.resource.data.priceType in ['free', 'paid']
        && request.resource.data.priceAmount is number
        && request.resource.data.storagePath is string
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.uploaderName is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.downloads == 0
        && request.resource.data.rating == 0
        && request.resource.data.ratingCount == 0;
    }

    function validOwnerNoteEdit() {
      return signedIn()
        && resource.data.uploadedBy == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'title',
          'description',
          'price',
          'priceType',
          'priceAmount'
        ])
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.priceType in ['free', 'paid']
        && request.resource.data.priceAmount is number;
    }

    function validDownloadIncrement() {
      return signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['downloads'])
        && request.resource.data.downloads == resource.data.downloads + 1;
    }

    function validRatingAggregateUpdate(noteId) {
      return signedIn()
        && !exists(/databases/$(database)/documents/notes/$(noteId)/ratings/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/notes/$(noteId)/ratings/$(request.auth.uid)).data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['rating', 'ratingCount'])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5
        && request.resource.data.ratingCount == resource.data.ratingCount + 1;
    }

    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /notes/{noteId} {
      allow read: if true;
      allow create: if validNoteCreate();
      allow update: if validOwnerNoteEdit()
        || validDownloadIncrement()
        || validRatingAggregateUpdate(noteId);
      allow delete: if signedIn() && resource.data.uploadedBy == request.auth.uid;

      match /ratings/{userId} {
        allow read: if true;
        allow create: if isOwner(userId)
          && !exists(/databases/$(database)/documents/notes/$(noteId)/ratings/$(userId))
          && request.resource.data.keys().hasOnly([
            'rating',
            'userId',
            'userName',
            'userAvatar',
            'createdAt'
          ])
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId) || noteOwner(noteId);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'text',
            'userId',
            'userName',
            'userAvatar',
            'createdAt'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(resource.data.userId) || noteOwner(noteId);
      }
    }

    match /payments/{paymentId} {
      allow read: if signedIn()
        && (resource.data.payerId == request.auth.uid || resource.data.uploadedBy == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'noteId',
          'noteTitle',
          'subject',
          'uploadedBy',
          'uploaderName',
          'payerId',
          'payerName',
          'payerEmail',
          'amountPaise',
          'amountRupees',
          'currency',
          'status',
          'razorpayPaymentId',
          'razorpayOrderId',
          'razorpaySignature',
          'createdAt'
        ])
        && request.resource.data.payerId == request.auth.uid
        && request.resource.data.uploadedBy is string
        && request.resource.data.amountPaise is int
        && request.resource.data.amountPaise > 0
        && request.resource.data.currency == 'INR'
        && request.resource.data.status == 'success'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
